<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI.Tools</RootNamespace>
    <PackageId>Lux.Form.Core</PackageId>
    <Description>LuxStack Form Core: Headless schema-driven form controller, validation, dirty tracking and multi-step wizard engine. Zero UI dependency, NativeAOT compatible.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
