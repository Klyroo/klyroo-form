<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Form</RootNamespace>
    <PackageId>Klyroo.Form.Core</PackageId>
    <PackageTags>klyroo;forms;form-builder;schema;validation;headless;nativeaot</PackageTags>
    <Description>Klyroo Form Core: Headless schema-driven form controller (typed FormSchema and FormController, runtime Klyroo.Form.Dynamic), validation, dirty tracking and multi-step wizard engine. Zero UI dependency, NativeAOT compatible.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Klyroo.Form" />
    <InternalsVisibleTo Include="Klyroo.Form.DataAnnotations" />
    <InternalsVisibleTo Include="Klyroo.Form.Tests" />
  </ItemGroup>
</Project>
