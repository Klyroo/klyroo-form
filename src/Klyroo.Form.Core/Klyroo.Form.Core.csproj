<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Form</RootNamespace>
    <PackageId>Klyroo.Form.Core</PackageId>
    <Description>Klyroo Form Core: Headless schema-driven form controller, validation, dirty tracking and multi-step wizard engine. Zero UI dependency, NativeAOT compatible.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
