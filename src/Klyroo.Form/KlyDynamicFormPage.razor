@namespace Klyroo.Form.Dynamic
@inherits KlyComponentBase
@implements IDisposable

@if (Form is not null)
{
    <FormPageShell Engine="@Form.Engine" Templates="@FieldTemplates" Submit="@SubmitAction" Class="@Class" @attributes="AdditionalAttributes" />
}

@code {
    private FormTexts Texts => Options.Extension<KlyrooFormOptions>().ResolveTexts(CurrentLocale.Code);

    /// <summary>The controller to render. Its schema must declare <see cref="DynamicFormSchema.Sections"/>.</summary>
    [Parameter] public required DynamicFormController Form { get; set; }

    /// <summary>Renderers of the <see cref="FormFieldKind.Custom"/> fields by <see cref="DynamicFieldSchema.CustomKey"/>, each a <c>RenderFragment&lt;DynamicControlContext&gt;</c> that draws the control. They win over the ones registered with <see cref="KlyrooFormOptions.CustomField"/>.</summary>
    [Parameter] public IReadOnlyDictionary<string, RenderFragment<DynamicControlContext>>? FieldTemplates { get; set; }

    /// <summary>Your save step: called with <see cref="DynamicFormController.BuildOutput"/> after validation and the schema hooks passed, while the form is still submitting. Return <c>true</c> when the save succeeded; the form is then clean and <see cref="OnSubmit"/> is raised. Return <c>false</c> to keep the edits dirty, after reporting the reason with <see cref="DynamicFormController.SetError"/> or <see cref="DynamicFormController.SetFormError"/>. The token is cancelled when the component is disposed.</summary>
    [Parameter] public Func<IReadOnlyDictionary<string, object?>, CancellationToken, Task<bool>>? OnSave { get; set; }

    /// <summary>Called with <see cref="DynamicFormController.BuildOutput"/> after the form is submitted successfully, that is after validation, the schema hooks and <see cref="OnSave"/> passed. The submission is over at that point and the form is clean.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> OnSubmit { get; set; }


    private Func<CancellationToken, Task<bool>> SubmitAction => SubmitAsync;

    protected override void OnParametersSet() => Form.UseLocaleMessages(Texts.Messages);

    private async Task<bool> SubmitAsync(CancellationToken cancellationToken)
    {
        var done = OnSave is { } save
            ? await Form.SubmitAsync((f, ct) => save(f.BuildOutput(), ct), cancellationToken)
            : await Form.SubmitAsync();
        if (done && OnSubmit.HasDelegate) await OnSubmit.InvokeAsync(Form.BuildOutput());
        return done;
    }

    public void Dispose() => Form.CancelPendingValidations();
}
