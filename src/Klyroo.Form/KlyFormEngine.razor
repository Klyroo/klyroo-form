@namespace Klyroo.Form
@inherits KlyComponentBase
@implements IDisposable

@if (EffectiveController is { } form)
{
    <form novalidate class="@RootClass" @onsubmit="OnFormSubmitAsync" @onsubmit:preventDefault
          data-slot="form-engine" data-key="@form.Schema.FormKey" data-shell="@Shell.ToString().ToLowerInvariant()"
          @attributes="AdditionalAttributes">
        @* Header + Stepper *@
        @if (!string.IsNullOrEmpty(form.Schema.Title) || !string.IsNullOrEmpty(form.Schema.Description) || (form.IsStepped && form.Schema.ShowStepper))
        {
            <header class="flex flex-col gap-3 border-b border-(--klyroo-border) pb-3" data-slot="form-header">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex flex-col gap-0.5">
                        @if (!string.IsNullOrEmpty(form.Schema.Eyebrow))
                        {
                            <span class="text-[11px] font-bold uppercase tracking-wider text-(--klyroo-primary-text)" data-slot="form-eyebrow">@form.Schema.Eyebrow</span>
                        }
                        @if (!string.IsNullOrEmpty(form.Schema.Title))
                        {
                            <h2 class="m-0 text-base font-bold text-(--klyroo-text-highlighted)" data-slot="form-title">@form.Schema.Title</h2>
                        }
                        @if (!string.IsNullOrEmpty(form.Schema.Description))
                        {
                            <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="form-description">@form.Schema.Description</p>
                        }
                    </div>
                    @if (Shell != FormShellMode.Inline && OnCancel.HasDelegate)
                    {
                        <button type="button"
                                class="inline-flex size-7 items-center justify-center rounded-(--klyroo-radius) text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted)"
                                aria-label="Close form"
                                data-slot="form-close"
                                @onclick="OnCancelAsync">✕</button>
                    }
                </div>

                @if (form.IsStepped && form.Schema.ShowStepper)
                {
                    <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0" data-slot="form-stepper">
                        @for (var i = 0; i < form.Schema.Steps.Count; i++)
                        {
                            var idx = i;
                            var step = form.Schema.Steps[i];
                            if (step.SkipWhen?.Invoke(form) == true) continue;
                            var isCurrent = idx == form.CurrentStepIndex;
                            var isDone = idx < form.CurrentStepIndex;
                            <li class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium @(isCurrent ? "bg-(--klyroo-primary) text-(--klyroo-primary-contrast)" : isDone ? "bg-(--klyroo-success)/15 text-(--klyroo-success-text)" : "bg-(--klyroo-bg-muted) text-(--klyroo-text-muted)")"
                                aria-current="@(isCurrent ? "step" : null)"
                                data-slot="form-step-badge"
                                data-step="@step.Key">
                                <span class="font-bold tabular-nums">@(idx + 1).</span>
                                <span>@step.Title</span>
                            </li>
                        }
                    </ol>
                }
            </header>
        }

        @if (form.CurrentStep is { Description: { Length: > 0 } stepDescription })
        {
            <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="form-step-description">@stepDescription</p>
        }

        @* Fields Grid *@
        <div class="grid gap-4" style="@(FormLayout.GridStyle(FormLayout.Columns(form.Schema)))" data-slot="form-fields">
            @foreach (var field in form.CurrentVisibleTopFields)
            {
                <KlySchemaField Form="form" Field="field" />
            }
        </div>

        @* Footer Actions *@
        <footer class="flex flex-wrap items-center justify-between gap-2 border-t border-(--klyroo-border) pt-3" data-slot="form-actions">
            <div class="flex items-center gap-2">
                @if (form.IsStepped && !form.IsFirstStep)
                {
                    <button type="button"
                            class="inline-flex h-9 items-center rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-3.5 text-xs font-semibold text-(--klyroo-text) hover:bg-(--klyroo-bg-muted)"
                            disabled="@form.IsSubmitting"
                            data-slot="form-action-prev"
                            @onclick="@(() => form.PreviousStepAsync())">
                        Back
                    </button>
                }
                @if (ShowReset && form.IsDirty)
                {
                    <button type="button"
                            class="inline-flex h-9 items-center rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-3 text-xs font-medium text-(--klyroo-text-muted) hover:bg-(--klyroo-bg-muted)"
                            data-slot="form-action-reset"
                            @onclick="@(() => form.Reset())">
                        Reset
                    </button>
                }
            </div>

            <div class="flex items-center gap-2">
                @if (OnCancel.HasDelegate)
                {
                    <button type="button"
                            class="inline-flex h-9 items-center rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-3.5 text-xs font-medium text-(--klyroo-text) hover:bg-(--klyroo-bg-muted)"
                            data-slot="form-action-cancel"
                            @onclick="OnCancelAsync">
                        Cancel
                    </button>
                }
                @if (form.IsStepped && !form.IsLastStep)
                {
                    <button type="button"
                            class="inline-flex h-9 items-center rounded-(--klyroo-radius) bg-(--klyroo-primary) px-4 text-xs font-semibold text-(--klyroo-primary-contrast) hover:opacity-90"
                            disabled="@form.IsSubmitting"
                            data-slot="form-action-next"
                            @onclick="@(() => form.NextStepAsync())">
                        Next
                    </button>
                }
                else
                {
                    <button type="submit"
                            class="inline-flex h-9 items-center rounded-(--klyroo-radius) bg-(--klyroo-primary) px-4 text-xs font-semibold text-(--klyroo-primary-contrast) hover:opacity-90 disabled:opacity-50"
                            disabled="@form.IsSubmitting"
                            data-slot="form-action-submit">
                        @(form.IsSubmitting ? "Saving…" : SubmitLabel)
                    </button>
                }
            </div>
        </footer>
    </form>
}

@code {
    private FormController? _internalController;
    private FormController? _subscribed;

    /// <summary>The controller to render. Use it when you need to read or change the form from code. Takes precedence over <see cref="Schema"/>.</summary>
    [Parameter] public FormController? Form { get; set; }

    /// <summary>The schema to render when no <see cref="Form"/> is given. The component creates and owns the controller, and creates a new one when the schema instance changes.</summary>
    [Parameter] public FormSchema? Schema { get; set; }

    /// <summary>Initial values by field key for the controller created from <see cref="Schema"/>. Ignored when <see cref="Form"/> is set.</summary>
    [Parameter] public IReadOnlyDictionary<string, object?>? Input { get; set; }

    /// <summary>How the form is presented. Anything other than <see cref="FormShellMode.Inline"/> adds a close button to the header when <see cref="OnCancel"/> is bound.</summary>
    [Parameter] public FormShellMode Shell { get; set; } = FormShellMode.Inline;

    /// <summary>Text of the submit button. The default is <c>Submit</c>.</summary>
    [Parameter] public string SubmitLabel { get; set; } = "Submit";

    /// <summary>Shows a reset button in the footer while the form is dirty. The default is <c>true</c>.</summary>
    [Parameter] public bool ShowReset { get; set; } = true;

    /// <summary>Called with <see cref="FormController.BuildOutput"/> after the form is submitted successfully, that is after validation and the schema hooks passed.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> OnSubmit { get; set; }

    /// <summary>Called with the current output when the user presses Cancel or the close button. When bound, the Cancel button is shown.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> OnCancel { get; set; }


    /// <summary>The controller in use: <see cref="Form"/> if set, otherwise the one the component created from <see cref="Schema"/>.</summary>
    public FormController? EffectiveController => Form ?? _internalController;

    private string RootClass =>
        $"flex w-full flex-col gap-4 text-sm text-(--klyroo-text) {Class}".Trim();

    protected override void OnParametersSet()
    {
        if (Form is null && Schema is not null && (_internalController is null || !ReferenceEquals(_internalController.Schema, Schema)))
        {
            _internalController = new FormController(Schema, Input);
        }

        var current = EffectiveController;
        if (!ReferenceEquals(_subscribed, current))
        {
            if (_subscribed is not null) _subscribed.Changed -= OnFormChanged;
            _subscribed = current;
            if (_subscribed is not null) _subscribed.Changed += OnFormChanged;
        }
    }

    private void OnFormChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnFormSubmitAsync()
    {
        if (EffectiveController is null) return;
        var ok = await EffectiveController.SubmitAsync();
        if (ok && OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(EffectiveController.BuildOutput());
        }
    }

    private async Task OnCancelAsync()
    {
        if (EffectiveController is null) return;
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync(EffectiveController.BuildOutput());
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnFormChanged;
        }
    }
}
