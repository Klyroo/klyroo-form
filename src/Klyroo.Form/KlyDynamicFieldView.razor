@namespace Klyroo.Form.Dynamic
@inherits KlyComponentBase

@if (Form is not null && Target is { } target)
{
    <FieldNodeView Engine="@Form.Engine" Node="@Form.NodeOf(target)" Templates="@FieldTemplates" />
}

@code {
    /// <summary>The controller that holds the value of the field.</summary>
    [Parameter, EditorRequired] public DynamicFormController Form { get; set; } = default!;

    /// <summary>The field to render, usually one of <see cref="DynamicFormController.CurrentVisibleTopFields"/>. Containers render their children too.</summary>
    [Parameter] public DynamicFieldSchema? Field { get; set; }

    /// <summary>The key of the field to render, as an alternative to <see cref="Field"/>: the field of <see cref="Form"/> with this key. <see cref="Field"/> wins when both are set. Nothing renders when the form has no field with this key.</summary>
    [Parameter] public string? Key { get; set; }

    /// <summary>Renderers of the <see cref="FormFieldKind.Custom"/> fields by <see cref="DynamicFieldSchema.CustomKey"/>. They win over the ones registered with <see cref="KlyrooFormOptions.CustomField(string, RenderFragment{DynamicControlContext})"/>, and reach the fields inside containers, tabs and lists.</summary>
    [Parameter] public IReadOnlyDictionary<string, RenderFragment<DynamicControlContext>>? FieldTemplates { get; set; }

    private DynamicFieldSchema? Target => Field ?? (Key is null ? null : Form?.AllFields.FirstOrDefault(f => f.Key == Key));
}
