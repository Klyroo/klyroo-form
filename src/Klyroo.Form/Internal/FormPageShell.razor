@namespace Klyroo.Form.Internal
@inherits KlyComponentBase
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject ILogger<FormPageShell> Logger

@if (Engine is { } form)
{
    var sectionStates = form.GetSectionStates();
    var blockingCount = sectionStates.Count(s => s.Status is FormPageSectionStatus.Invalid or FormPageSectionStatus.Pending);

    <form novalidate class="@RootClass" data-slot="form-page" data-key="@form.Schema.FormKey"
          aria-busy="@(form.IsSubmitting ? "true" : null)"
          @onsubmit="OnSubmitAsync" @onsubmit:preventDefault @attributes="AdditionalAttributes">
        @if (!string.IsNullOrEmpty(form.Schema.Title) || !string.IsNullOrEmpty(form.Schema.Description))
        {
            <header class="flex flex-wrap items-start justify-between gap-4 border-b border-(--klyroo-border) pb-4" data-slot="form-page-header">
                <div class="flex flex-col gap-1">
                    @if (!string.IsNullOrEmpty(form.Schema.Eyebrow))
                    {
                        <span class="text-xs font-bold uppercase tracking-wider text-(--klyroo-primary-text)">@form.Schema.Eyebrow</span>
                    }
                    <h1 class="m-0 text-xl font-bold text-(--klyroo-text-highlighted)" data-slot="form-page-title">@form.Schema.Title</h1>
                    @if (!string.IsNullOrEmpty(form.Schema.Description))
                    {
                        <p class="m-0 text-xs text-(--klyroo-text-muted)">@form.Schema.Description</p>
                    }
                </div>
                <div class="flex items-center gap-2 text-xs text-(--klyroo-text-muted)" data-slot="form-page-summary">
                    <span>@(blockingCount == 0 ? Texts.AllReady : Texts.LeftToComplete(blockingCount))</span>
                </div>
            </header>
        }

        <KlyFormErrorSummary Form="@((IFormRuntime)form.Owner!)" />

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
            @* Sidebar navigation *@
            @if (sectionStates.Count > 0)
            {
                <aside class="lg:col-span-3" data-slot="form-page-nav">
                    <nav class="sticky top-4 flex flex-col gap-1 rounded-(--klyroo-radius-md) border border-(--klyroo-border) bg-(--klyroo-bg) p-3"
                         aria-label="@Texts.FormSections">
                        <span class="mb-1 px-2 text-[11px] font-bold uppercase tracking-wider text-(--klyroo-text-muted)">@Texts.FormSections</span>
                        @foreach (var sec in sectionStates)
                        {
                            var statusBadge = sec.Status switch
                            {
                                FormPageSectionStatus.Complete => (Texts.SectionComplete, KlyColor.Success),
                                FormPageSectionStatus.Invalid => (Texts.SectionInvalid, KlyColor.Error),
                                FormPageSectionStatus.Optional => (Texts.SectionOptional, KlyColor.Neutral),
                                _ => (Texts.SectionProgress(sec.RequiredCount - sec.MissingCount, sec.RequiredCount), KlyColor.Warning),
                            };
                            <a href="@($"#{sec.Key}")"
                               class="flex items-center justify-between gap-2 rounded-(--klyroo-radius) px-2.5 py-1.5 text-xs font-medium text-(--klyroo-text) hover:bg-(--klyroo-bg-muted)"
                               data-slot="form-page-nav-item"
                               data-section="@sec.Key"
                               data-status="@sec.Status.ToString().ToLowerInvariant()">
                                <span class="truncate">@sec.Label</span>
                                <KlyBadge Label="@statusBadge.Item1" Color="statusBadge.Item2" Variant="KlyVariant.Subtle" Size="KlySize.Sm" />
                            </a>
                        }
                    </nav>
                </aside>
            }

            @* Sections stack *@
            <div class="@(sectionStates.Count > 0 ? "lg:col-span-9" : "lg:col-span-12") flex flex-col gap-4" data-slot="form-page-sections">
                <div class="grid grid-cols-12 gap-4">
                @foreach (var sectionSchema in form.Schema.Sections.Where(form.IsSectionVisible))
                {
                    var state = sectionStates.First(s => s.Key == sectionSchema.Key);
                    <section id="@sectionSchema.Key"
                             style="@($"--kly-section-span: span {Math.Clamp(sectionSchema.Span, 1, 12)} / span {Math.Clamp(sectionSchema.Span, 1, 12)}")"
                             class="col-span-12 lg:[grid-column:var(--kly-section-span)] flex flex-col gap-3 rounded-(--klyroo-radius-md) border @(state.Dirty ? "border-(--klyroo-primary-text)" : "border-(--klyroo-border)") bg-(--klyroo-bg) p-4"
                             data-slot="form-page-section"
                             data-key="@sectionSchema.Key"
                             data-dirty="@(state.Dirty ? "true" : "false")"
                             data-status="@state.Status.ToString().ToLowerInvariant()">
                        <div class="flex items-start justify-between gap-2 border-b border-(--klyroo-border) pb-2.5">
                            <div class="flex flex-col gap-0.5">
                                <h2 class="m-0 text-sm font-bold text-(--klyroo-text-highlighted)" data-slot="form-section-title">@sectionSchema.Label</h2>
                                @if (!string.IsNullOrEmpty(sectionSchema.Description))
                                {
                                    <p class="m-0 text-xs text-(--klyroo-text-muted)">@sectionSchema.Description</p>
                                }
                            </div>
                            @if (state.Dirty)
                            {
                                <button type="button"
                                        class="rounded-(--klyroo-radius) px-2 py-1 text-xs font-medium text-(--klyroo-primary-text) hover:bg-(--klyroo-bg-muted)"
                                        disabled="@form.IsSubmitting"
                                        data-slot="form-section-reset"
                                        @onclick="@(() => form.ResetSection(sectionSchema.Key))">
                                    @Texts.Reset
                                </button>
                            }
                        </div>

                        <div class="grid gap-4" style="@(FormLayout.GridStyle(FormLayout.Columns(form.Schema)))" data-slot="form-page-fields">
                            @foreach (var field in sectionSchema.Fields)
                            {
                                <FieldNodeView Engine="@form" Node="@field" Templates="@Templates" />
                            }
                        </div>
                    </section>
                }
                </div>

                <div class="flex justify-end gap-2 pt-2">
                    <button type="submit"
                            class="inline-flex h-9 items-center rounded-(--klyroo-radius) bg-(--klyroo-primary) px-4 text-xs font-semibold text-(--klyroo-primary-contrast) hover:opacity-90 disabled:opacity-50"
                            disabled="@form.IsSubmitting"
                            data-slot="form-page-submit">
                        @(form.IsSubmitting ? Texts.Saving : Texts.Submit)
                    </button>
                </div>
            </div>
        </div>
    </form>
}

@code {
    private FormTexts Texts => Options.Extension<KlyrooFormOptions>().ResolveTexts(CurrentLocale.Code);

    private FormEngine? _subscribed;
    private readonly CancellationTokenSource _disposed = new();
    private FormJs _js = default!;
    private string? _focusTarget;

    // The parameters have internal types, so they are not [Parameter] properties (Blazor needs those to be public): SetParametersAsync reads them by name.
    internal FormEngine? Engine { get; private set; }

    // Renderers of the Custom fields of a dynamic form, passed on to the fields.
    internal IReadOnlyDictionary<string, RenderFragment<DynamicControlContext>>? Templates { get; private set; }

    // Validates, saves and raises OnSubmit of the component that holds the form: true when the form was submitted. The token is cancelled when the shell is disposed.
    internal Func<CancellationToken, Task<bool>> Submit { get; private set; } = _ => Task.FromResult(false);

    /// <inheritdoc/>
    public override Task SetParametersAsync(ParameterView parameters)
    {
        foreach (var parameter in parameters)
        {
            switch (parameter.Name)
            {
                case nameof(Engine): Engine = (FormEngine?)parameter.Value; break;
                case nameof(Templates): Templates = (IReadOnlyDictionary<string, RenderFragment<DynamicControlContext>>?)parameter.Value; break;
                case nameof(Submit): Submit = (Func<CancellationToken, Task<bool>>)parameter.Value; break;
            }
        }
        return base.SetParametersAsync(parameters);
    }

    private string RootClass =>
        $"flex w-full flex-col gap-6 text-sm text-(--klyroo-text) {Class}".Trim();

    protected override void OnInitialized() => _js = new FormJs(Js);

    protected override void OnParametersSet()
    {
        AdditionalAttributes = InternalParameters.Without(AdditionalAttributes, "Engine", "Templates", "Submit");
        Engine?.UseLocaleMessages(Texts.Messages);
        if (!ReferenceEquals(_subscribed, Engine))
        {
            if (_subscribed is not null) _subscribed.Changed -= OnChanged;
            _subscribed = Engine;
            if (_subscribed is not null) _subscribed.Changed += OnChanged;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnSubmitAsync()
    {
        var form = Engine;
        if (form is null || form.IsSubmitting) return;
        var ok = await FormRun.RunAsync(() => Submit(_disposed.Token), form, Logger, Texts, _disposed.Token);
        if (!ok)
        {
            _focusTarget = FormLayout.FirstErrorTargetId(form);
            if (_focusTarget is not null) StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTarget is { } target)
        {
            _focusTarget = null;
            await _js.FocusAsync(target);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribed is not null) _subscribed.Changed -= OnChanged;
        await _disposed.CancelAsync();
        _disposed.Dispose();
        await _js.DisposeAsync();
    }
}
