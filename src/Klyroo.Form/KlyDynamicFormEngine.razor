@namespace Klyroo.Form.Dynamic
@inherits KlyComponentBase
@implements IAsyncDisposable

@if (EffectiveController is { } form)
{
    <FormShell Engine="@form.Engine" Templates="@FieldTemplates" Shell="@Shell" SubmitLabel="@SubmitLabel" ShowReset="@ShowReset"
               Submit="@SubmitAction" Cancel="@CancelAction" Class="@Class" @attributes="AdditionalAttributes" />
}

@code {
    private FormTexts Texts => Options.Extension<KlyrooFormOptions>().ResolveTexts(CurrentLocale.Code);

    private DynamicFormController? _internalController;

    /// <summary>The controller to render. Use it when you need to read or change the form from code. Takes precedence over <see cref="Schema"/>.</summary>
    [Parameter] public DynamicFormController? Form { get; set; }

    /// <summary>The schema to render when no <see cref="Form"/> is given. The component creates and owns the controller, and creates a new one when the schema instance changes.</summary>
    [Parameter] public DynamicFormSchema? Schema { get; set; }

    /// <summary>Initial values by field key for the controller created from <see cref="Schema"/>. Ignored when <see cref="Form"/> is set.</summary>
    [Parameter] public IReadOnlyDictionary<string, object?>? Input { get; set; }

    /// <summary>How the form is presented. Anything other than <see cref="FormShellMode.Inline"/> adds a close button to the header when <see cref="OnCancel"/> is bound.</summary>
    [Parameter] public FormShellMode Shell { get; set; } = FormShellMode.Inline;

    /// <summary>Renderers of the <see cref="FormFieldKind.Custom"/> fields by <see cref="DynamicFieldSchema.CustomKey"/>, each a <c>RenderFragment&lt;DynamicControlContext&gt;</c> that draws the control. They win over the ones registered with <see cref="KlyrooFormOptions.CustomField"/>.</summary>
    [Parameter] public IReadOnlyDictionary<string, RenderFragment<DynamicControlContext>>? FieldTemplates { get; set; }

    /// <summary>Text of the submit button. The default is the <c>Submit</c> text of the current locale (<see cref="FormTexts.Submit"/>).</summary>
    [Parameter] public string? SubmitLabel { get; set; }

    /// <summary>Shows a reset button in the footer while the form is dirty. The default is <c>true</c>.</summary>
    [Parameter] public bool ShowReset { get; set; } = true;

    /// <summary>Your save step: called with <see cref="DynamicFormController.BuildOutput"/> after validation and the schema hooks passed, while the form is still submitting (the button shows its saving state, a second submit is refused, Cancel is disabled). Return <c>true</c> when the save succeeded; the form is then clean and <see cref="OnSubmit"/> is raised. Return <c>false</c> to keep the user's edits dirty and the form open, after reporting the reason with <see cref="DynamicFormController.SetError"/> or <see cref="DynamicFormController.SetFormError"/>. The token is cancelled when the component is disposed. It runs through <see cref="DynamicFormController.SubmitAsync(Func{DynamicFormController, CancellationToken, Task{bool}}, CancellationToken)"/>.</summary>
    [Parameter] public Func<IReadOnlyDictionary<string, object?>, CancellationToken, Task<bool>>? OnSave { get; set; }

    /// <summary>Called with <see cref="DynamicFormController.BuildOutput"/> after the form is submitted successfully, that is after validation, the schema hooks and <see cref="OnSave"/> passed. At that point the submission is over: <see cref="DynamicFormController.IsSubmitting"/> is <c>false</c> and the form is clean. Do the save itself in <see cref="OnSave"/>.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> OnSubmit { get; set; }

    /// <summary>Called with the current output when the user presses Cancel or the close button. When bound, the Cancel button is shown.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> OnCancel { get; set; }


    /// <summary>The controller in use: <see cref="Form"/> if set, otherwise the one the component created from <see cref="Schema"/>.</summary>
    public DynamicFormController? EffectiveController => Form ?? _internalController;

    private Func<CancellationToken, Task<bool>> SubmitAction => SubmitAsync;

    private Func<Task>? CancelAction => OnCancel.HasDelegate ? OnCancelAsync : null;

    protected override void OnParametersSet()
    {
        if (Form is null && Schema is not null && (_internalController is null || !ReferenceEquals(_internalController.Schema, Schema)))
        {
            _internalController?.Dispose();
            _internalController = new DynamicFormController(Schema, Input);
        }

        EffectiveController?.UseLocaleMessages(Texts.Messages);
    }

    private async Task<bool> SubmitAsync(CancellationToken cancellationToken)
    {
        var form = EffectiveController;
        if (form is null) return false;
        var done = OnSave is { } save
            ? await form.SubmitAsync((f, ct) => save(f.BuildOutput(), ct), cancellationToken)
            : await form.SubmitAsync();
        if (done && OnSubmit.HasDelegate) await OnSubmit.InvokeAsync(form.BuildOutput());
        return done;
    }

    private async Task OnCancelAsync()
    {
        if (EffectiveController is { } form) await OnCancel.InvokeAsync(form.BuildOutput());
    }

    public ValueTask DisposeAsync()
    {
        // The controller the component created goes with it; one you passed stays yours, but nobody is left to show its pending checks.
        if (_internalController is not null) _internalController.Dispose();
        else Form?.CancelPendingValidations();
        return ValueTask.CompletedTask;
    }
}
