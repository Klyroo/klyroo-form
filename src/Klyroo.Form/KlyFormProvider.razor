@namespace Klyroo.Form
@inherits KlyComponentBase
@implements IDisposable
@inject FormService FormApi

@if (ChildContent is not null)
{
    @ChildContent
}

@if (FormApi.IsOpen && FormApi.ActiveForm is { } activeForm)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/55 p-4"
         role="dialog" aria-modal="true" aria-label="@(activeForm.Schema.Title ?? "Form")"
         data-slot="form-provider-overlay" data-mode="@FormApi.ActiveMode.ToString().ToLowerInvariant()">
        <div class="max-h-[90dvh] w-full max-w-2xl overflow-y-auto rounded-(--klyroo-radius-lg) border border-(--klyroo-border) bg-(--klyroo-bg) p-5 shadow-xl"
             data-slot="form-provider-dialog">
            <KlyFormEngine Form="@activeForm"
                          Shell="@FormApi.ActiveMode"
                          OnSubmit="@(_ => FormApi.SubmitActiveFormAsync())"
                          OnCancel="@(_ => FormApi.CloseForm())" />
        </div>
    </div>
}

@code {
    /// <summary>The content of the provider, usually the page body. Overlay forms render after it.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        FormApi.Changed += OnFormApiChanged;
    }

    private void OnFormApiChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        FormApi.Changed -= OnFormApiChanged;
    }
}
