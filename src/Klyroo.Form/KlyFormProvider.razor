@namespace Klyroo.Form
@inherits KlyComponentBase
@implements IDisposable
@inject DynamicFormService DynamicApi
@inject FormService TypedApi

@if (ChildContent is not null)
{
    @ChildContent
}

@* The overlay is a Klyroo.UI modal (or slideover): a native modal dialog, so focus stays inside, Escape closes it and focus goes back to
   the element that opened it. It stays in the DOM once a form has been opened, closed, so that closing it also restores focus. One
   overlay serves the typed forms of FormService and another the runtime forms of DynamicFormService. *@
@Overlay(_typed, TypedApi.Active is { } typed ? new Shown(typed.Title, typed.Mode, typed.Engine.IsSubmitting, typed.Body(), TypedApi.CloseForm) : null)
@Overlay(_dynamic, DynamicApi.ActiveForm is { } dynamic ? new Shown(dynamic.Schema.Title, DynamicApi.ActiveMode, dynamic.IsSubmitting, DynamicBody(dynamic, DynamicApi.ActiveMode), DynamicApi.CloseForm) : null)

@code {
    private const string FullscreenClass = "m-0 h-dvh max-h-none w-screen max-w-none rounded-none";

    private FormTexts Texts => Options.Extension<KlyrooFormOptions>().ResolveTexts(CurrentLocale.Code);

    // What an open overlay shows; the slot remembers the last one, which the closing render still needs.
    private sealed record Shown(string? Title, FormShellMode Mode, bool Busy, RenderFragment Body, Action Close);

    private sealed class Slot
    {
        public bool EverOpened;
        public FormShellMode Mode = FormShellMode.Modal;
        public string? LastTitle;
        public FormEngine? Subscribed;
        public Action? Close;
    }

    private readonly Slot _typed = new();
    private readonly Slot _dynamic = new();

    /// <summary>The content of the provider, usually the page body. Overlay forms render after it.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Track();
        TypedApi.Changed += OnApiChanged;
        DynamicApi.Changed += OnApiChanged;
    }

    private RenderFragment Overlay(Slot slot, Shown? shown) => __builder =>
    {
        if (!slot.EverOpened) return;
        var open = shown is not null;
        var label = shown?.Title ?? slot.LastTitle ?? Texts.FormTitle;
        var mode = slot.Mode;
        // The overlay cannot be dismissed while the form saves.
        var busy = shown?.Busy == true;
        <div class="contents" data-slot="form-provider-overlay" data-mode="@mode.ToString().ToLowerInvariant()" data-open="@(open ? "true" : "false")">
            @if (mode == FormShellMode.Drawer)
            {
                <KlySlideover Open="open" OpenChanged="@(isOpen => OnOpenChanged(slot, isOpen))" AriaLabel="@label" Close="false" Dismissible="!busy"
                              Body="@(shown?.Body ?? Empty)" data-form-dialog="true" />
            }
            else
            {
                <KlyModal Open="open" OpenChanged="@(isOpen => OnOpenChanged(slot, isOpen))" AriaLabel="@label" Close="false" Dismissible="!busy"
                          Size="KlySize.Lg" Class="@(mode == FormShellMode.Fullscreen ? FullscreenClass : null)"
                          Body="@(shown?.Body ?? Empty)" data-form-dialog="true" />
            }
        </div>
    };

    private static readonly RenderFragment Empty = _ => { };

    // Remember the mode, the title and the close action of the last open form of each kind: the closing render still needs them.
    private void Track()
    {
        Track(_typed, TypedApi.Active is { } t ? (t.Engine, t.Title, t.Mode, (Action)TypedApi.CloseForm) : null);
        Track(_dynamic, DynamicApi.ActiveForm is { } d ? (d.Engine, d.Schema.Title, DynamicApi.ActiveMode, (Action)DynamicApi.CloseForm) : null);
    }

    private void Track(Slot slot, (FormEngine Engine, string? Title, FormShellMode Mode, Action Close)? active)
    {
        // Re-render when the form starts and stops submitting.
        var engine = active?.Engine;
        if (!ReferenceEquals(slot.Subscribed, engine))
        {
            if (slot.Subscribed is not null) slot.Subscribed.Changed -= OnControllerChanged;
            slot.Subscribed = engine;
            if (engine is not null) engine.Changed += OnControllerChanged;
        }
        if (active is not { } a) return;
        slot.EverOpened = true;
        slot.Mode = a.Mode;
        slot.LastTitle = a.Title;
        slot.Close = a.Close;
    }

    private RenderFragment DynamicBody(DynamicFormController form, FormShellMode mode) =>
        @<div class="@(mode == FormShellMode.Fullscreen ? "mx-auto w-full max-w-3xl" : "w-full")">
            <KlyDynamicFormEngine @key="form" Form="@form"
                           Shell="@mode"
                           OnSubmit="@(_ => DynamicApi.CompleteSubmittedForm(form))"
                           OnCancel="@(_ => DynamicApi.CloseForm())" />
        </div>;

    // Escape, a click on the backdrop and the browser closing the dialog all arrive here.
    private void OnOpenChanged(Slot slot, bool open)
    {
        if (!open) slot.Close?.Invoke();
    }

    private void OnControllerChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnApiChanged()
    {
        Track();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TypedApi.Changed -= OnApiChanged;
        DynamicApi.Changed -= OnApiChanged;
        if (_typed.Subscribed is not null) _typed.Subscribed.Changed -= OnControllerChanged;
        if (_dynamic.Subscribed is not null) _dynamic.Subscribed.Changed -= OnControllerChanged;
    }
}
