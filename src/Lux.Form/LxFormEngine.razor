@namespace Lux.Form
@using System.Globalization
@inherits LxComponentBase
@implements IDisposable

@if (EffectiveController is { } form)
{
    <form novalidate class="@RootClass" @onsubmit="OnFormSubmitAsync" @onsubmit:preventDefault
          data-slot="form-engine" data-key="@form.Schema.FormKey" data-shell="@Shell.ToString().ToLowerInvariant()"
          @attributes="AdditionalAttributes">
        @* Header + Stepper *@
        @if (!string.IsNullOrEmpty(form.Schema.Title) || !string.IsNullOrEmpty(form.Schema.Description) || (form.IsStepped && form.Schema.ShowStepper))
        {
            <header class="flex flex-col gap-3 border-b border-(--lux-border) pb-3" data-slot="form-header">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex flex-col gap-0.5">
                        @if (!string.IsNullOrEmpty(form.Schema.Eyebrow))
                        {
                            <span class="text-[11px] font-bold uppercase tracking-wider text-(--lux-primary-text)" data-slot="form-eyebrow">@form.Schema.Eyebrow</span>
                        }
                        @if (!string.IsNullOrEmpty(form.Schema.Title))
                        {
                            <h2 class="m-0 text-base font-bold text-(--lux-text-highlighted)" data-slot="form-title">@form.Schema.Title</h2>
                        }
                        @if (!string.IsNullOrEmpty(form.Schema.Description))
                        {
                            <p class="m-0 text-xs text-(--lux-text-muted)" data-slot="form-description">@form.Schema.Description</p>
                        }
                    </div>
                    @if (Shell != FormShellMode.Inline && OnCancel.HasDelegate)
                    {
                        <button type="button"
                                class="inline-flex size-7 items-center justify-center rounded-(--lux-radius) text-(--lux-text-muted) hover:bg-(--lux-bg-muted)"
                                aria-label="Close form"
                                data-slot="form-close"
                                @onclick="OnCancelAsync">✕</button>
                    }
                </div>

                @if (form.IsStepped && form.Schema.ShowStepper)
                {
                    <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0" data-slot="form-stepper">
                        @for (var i = 0; i < form.Schema.Steps.Count; i++)
                        {
                            var idx = i;
                            var step = form.Schema.Steps[i];
                            if (step.SkipWhen?.Invoke(form) == true) continue;
                            var isCurrent = idx == form.CurrentStepIndex;
                            var isDone = idx < form.CurrentStepIndex;
                            <li class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium @(isCurrent ? "bg-(--lux-primary) text-(--lux-primary-contrast)" : isDone ? "bg-(--lux-success)/15 text-(--lux-success-text)" : "bg-(--lux-bg-muted) text-(--lux-text-muted)")"
                                aria-current="@(isCurrent ? "step" : null)"
                                data-slot="form-step-badge"
                                data-step="@step.Key">
                                <span class="font-bold tabular-nums">@(idx + 1).</span>
                                <span>@step.Title</span>
                            </li>
                        }
                    </ol>
                }
            </header>
        }

        @* Fields Grid *@
        <div class="grid grid-cols-12 gap-4" data-slot="form-fields">
            @foreach (var field in form.CurrentVisibleTopFields)
            {
                @RenderField(form, field)
            }
        </div>

        @* Footer Actions *@
        <footer class="flex flex-wrap items-center justify-between gap-2 border-t border-(--lux-border) pt-3" data-slot="form-actions">
            <div class="flex items-center gap-2">
                @if (form.IsStepped && !form.IsFirstStep)
                {
                    <button type="button"
                            class="inline-flex h-9 items-center rounded-(--lux-radius) border border-(--lux-border) bg-(--lux-bg) px-3.5 text-xs font-semibold text-(--lux-text) hover:bg-(--lux-bg-muted)"
                            disabled="@form.IsSubmitting"
                            data-slot="form-action-prev"
                            @onclick="@(() => form.PreviousStepAsync())">
                        Back
                    </button>
                }
                @if (ShowReset && form.IsDirty)
                {
                    <button type="button"
                            class="inline-flex h-9 items-center rounded-(--lux-radius) border border-(--lux-border) bg-(--lux-bg) px-3 text-xs font-medium text-(--lux-text-muted) hover:bg-(--lux-bg-muted)"
                            data-slot="form-action-reset"
                            @onclick="@(() => form.Reset())">
                        Reset
                    </button>
                }
            </div>

            <div class="flex items-center gap-2">
                @if (OnCancel.HasDelegate)
                {
                    <button type="button"
                            class="inline-flex h-9 items-center rounded-(--lux-radius) border border-(--lux-border) bg-(--lux-bg) px-3.5 text-xs font-medium text-(--lux-text) hover:bg-(--lux-bg-muted)"
                            data-slot="form-action-cancel"
                            @onclick="OnCancelAsync">
                        Cancel
                    </button>
                }
                @if (form.IsStepped && !form.IsLastStep)
                {
                    <button type="button"
                            class="inline-flex h-9 items-center rounded-(--lux-radius) bg-(--lux-primary) px-4 text-xs font-semibold text-(--lux-primary-contrast) hover:opacity-90"
                            disabled="@form.IsSubmitting"
                            data-slot="form-action-next"
                            @onclick="@(() => form.NextStepAsync())">
                        Next
                    </button>
                }
                else
                {
                    <button type="submit"
                            class="inline-flex h-9 items-center rounded-(--lux-radius) bg-(--lux-primary) px-4 text-xs font-semibold text-(--lux-primary-contrast) hover:opacity-90 disabled:opacity-50"
                            disabled="@form.IsSubmitting"
                            data-slot="form-action-submit">
                        @(form.IsSubmitting ? "Saving…" : SubmitLabel)
                    </button>
                }
            </div>
        </footer>
    </form>
}

@code {
    private FormController? _internalController;
    private FormController? _subscribed;
    private readonly HashSet<string> _revealedPasswords = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _activeTabs = new(StringComparer.Ordinal);

    [Parameter] public FormController? Form { get; set; }
    [Parameter] public FormSchema? Schema { get; set; }
    [Parameter] public IReadOnlyDictionary<string, object?>? Input { get; set; }
    [Parameter] public FormShellMode Shell { get; set; } = FormShellMode.Inline;
    [Parameter] public string SubmitLabel { get; set; } = "Submit";
    [Parameter] public bool ShowReset { get; set; } = true;
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> OnSubmit { get; set; }
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> OnCancel { get; set; }

    public FormController? EffectiveController => Form ?? _internalController;

    private string RootClass =>
        $"flex w-full flex-col gap-4 text-sm text-(--lux-text) {Class}".Trim();

    protected override void OnParametersSet()
    {
        if (Form is null && Schema is not null && (_internalController is null || !ReferenceEquals(_internalController.Schema, Schema)))
        {
            _internalController = new FormController(Schema, Input);
        }

        var current = EffectiveController;
        if (!ReferenceEquals(_subscribed, current))
        {
            if (_subscribed is not null) _subscribed.Changed -= OnFormChanged;
            _subscribed = current;
            if (_subscribed is not null) _subscribed.Changed += OnFormChanged;
        }
    }

    private void OnFormChanged() => _ = InvokeAsync(StateHasChanged);

    private RenderFragment RenderField(FormController form, FormFieldSchema field)
    {
        if (!form.ShouldRenderField(field)) return @<text></text>;

        var spanStyle = $"grid-column: span {Math.Clamp(field.Span, 1, 12)} / span {Math.Clamp(field.Span, 1, 12)}";

        if (field.Kind == FormFieldKind.Hidden)
        {
            return @<input type="hidden" name="@field.Key" value="@(form.GetValue(field.Key)?.ToString())" data-form-field="@field.Key" />;
        }

        if (field.Kind == FormFieldKind.Divider)
        {
            return @<div style="@spanStyle" class="my-1 border-t border-(--lux-border)" data-slot="form-divider"></div>;
        }

        if (field.Kind == FormFieldKind.Section)
        {
            return @<div style="@spanStyle" class="flex flex-col gap-0.5 pt-2" data-slot="form-section-heading">
                <h3 class="m-0 text-sm font-bold text-(--lux-text-highlighted)">@field.Label</h3>
                @if (!string.IsNullOrEmpty(field.Description))
                {
                    <p class="m-0 text-xs text-(--lux-text-muted)">@field.Description</p>
                }
            </div>;
        }

        if (field.Kind == FormFieldKind.Info)
        {
            return @<div style="@spanStyle" class="rounded-(--lux-radius) border border-(--lux-border) bg-(--lux-bg-muted) p-3 text-xs" data-slot="form-info" data-form-field="@field.Key">
                @if (!string.IsNullOrEmpty(field.Label))
                {
                    <p class="m-0 font-semibold text-(--lux-text-highlighted)">@field.Label</p>
                }
                @if (!string.IsNullOrEmpty(field.DisplayText ?? field.Description))
                {
                    <p class="m-0 text-(--lux-text-muted)">@(field.DisplayText ?? field.Description)</p>
                }
            </div>;
        }

        if (field.Kind is FormFieldKind.Group or FormFieldKind.Card or FormFieldKind.Object)
        {
            var isCard = field.Kind == FormFieldKind.Card;
            return @<div style="@spanStyle"
                         class="flex flex-col gap-3 @(isCard ? "rounded-(--lux-radius-md) border border-(--lux-border) bg-(--lux-bg) p-4" : "")"
                         data-slot="form-container" data-kind="@field.Kind.ToString().ToLowerInvariant()">
                @if (!string.IsNullOrEmpty(field.Label))
                {
                    <div class="flex flex-col gap-0.5">
                        <h4 class="m-0 text-sm font-semibold text-(--lux-text-highlighted)">@field.Label</h4>
                        @if (!string.IsNullOrEmpty(field.Description))
                        {
                            <p class="m-0 text-xs text-(--lux-text-muted)">@field.Description</p>
                        }
                    </div>
                }
                <div class="grid grid-cols-12 gap-4">
                    @if (field.Fields is not null)
                    {
                        @foreach (var child in field.Fields)
                        {
                            @RenderField(form, child)
                        }
                    }
                </div>
            </div>;
        }

        if (field.Kind == FormFieldKind.Tabs && field.Tabs is { Count: > 0 })
        {
            var visibleTabs = field.Tabs.Where(t => t.Condition is null || t.Condition(form)).ToList();
            if (visibleTabs.Count == 0) return @<text></text>;
            if (!_activeTabs.TryGetValue(field.Key, out var activeKey) || visibleTabs.All(t => t.Key != activeKey))
            {
                activeKey = visibleTabs[0].Key;
                _activeTabs[field.Key] = activeKey;
            }
            var activeTab = visibleTabs.First(t => t.Key == activeKey);
            return @<div style="@spanStyle" class="flex flex-col gap-3" data-slot="form-tabs" data-form-field="@field.Key">
                <div class="flex items-center gap-1 border-b border-(--lux-border) pb-1.5" role="tablist">
                    @foreach (var tab in visibleTabs)
                    {
                        var isSelected = tab.Key == activeKey;
                        <button type="button" role="tab" aria-selected="@(isSelected ? "true" : "false")"
                                class="rounded-(--lux-radius) px-3 py-1 text-xs font-semibold @(isSelected ? "bg-(--lux-bg-muted) text-(--lux-text-highlighted)" : "text-(--lux-text-muted) hover:text-(--lux-text)")"
                                data-slot="form-tab-trigger" data-tab="@tab.Key"
                                @onclick="@(() => _activeTabs[field.Key] = tab.Key)">
                            @tab.Label
                        </button>
                    }
                </div>
                <div class="grid grid-cols-12 gap-4" data-slot="form-tab-panel">
                    @foreach (var child in activeTab.Fields)
                    {
                        @RenderField(form, child)
                    }
                </div>
            </div>;
        }

        if (field.Kind is FormFieldKind.ArrayList or FormFieldKind.ArrayTable)
        {
            return RenderArrayField(form, field, spanStyle);
        }

        var error = form.GetError(field.Key);
        var required = form.IsFieldRequired(field);
        var disabled = form.IsFieldDisabled(field);
        var isDirty = form.DirtyPaths.Contains(field.Key);
        var fieldId = $"lx-ff-{field.Key.Replace('.', '-')}";

        return @<div style="@spanStyle" class="flex flex-col gap-1.5" data-slot="form-field" data-form-field="@field.Key" data-invalid="@(error is not null ? "true" : null)">
            @if (!string.IsNullOrEmpty(field.Label) && field.Kind != FormFieldKind.Checkbox)
            {
                <div class="flex items-center justify-between gap-2">
                    <label for="@fieldId" class="text-xs font-semibold text-(--lux-text-highlighted)" data-slot="form-field-label">
                        @field.Label
                        @if (required)
                        {
                            <span class="ms-0.5 text-(--lux-error-text)" aria-hidden="true">*</span>
                        }
                    </label>
                    <div class="flex items-center gap-2 text-xs text-(--lux-text-muted)">
                        @if (!string.IsNullOrEmpty(field.Hint))
                        {
                            <span data-slot="form-field-hint">@field.Hint</span>
                        }
                        @if (field.DirtyCheck && isDirty)
                        {
                            <button type="button" class="text-(--lux-primary-text) hover:underline"
                                    data-slot="form-field-reset" @onclick="@(() => form.ResetField(field.Key))">
                                Reset
                            </button>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(field.Description))
            {
                <p class="m-0 text-xs text-(--lux-text-muted)" data-slot="form-field-description">@field.Description</p>
            }

            @RenderControl(form, field, fieldId, disabled, error)

            @if (disabled && !string.IsNullOrEmpty(field.DisabledReason))
            {
                <span class="text-xs text-(--lux-text-muted)" data-slot="form-field-disabled-reason">🔒 @field.DisabledReason</span>
            }

            @if (!string.IsNullOrEmpty(field.Help))
            {
                <span class="text-xs text-(--lux-text-muted)" data-slot="form-field-help">@field.Help</span>
            }

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="m-0 text-xs font-medium text-(--lux-error-text)" role="alert" data-slot="form-field-error">@error</p>
            }
        </div>;
    }

    private RenderFragment RenderControl(FormController form, FormFieldSchema field, string fieldId, bool disabled, string? error)
    {
        var inputClass = $"h-9 w-full rounded-(--lux-radius) border {(error is not null ? "border-(--lux-error)" : "border-(--lux-border)")} bg-(--lux-bg) px-3 text-xs text-(--lux-text) disabled:opacity-50";

        switch (field.Kind)
        {
            case FormFieldKind.Textarea:
                return @<textarea id="@fieldId"
                                  rows="3"
                                  disabled="@disabled"
                                  placeholder="@field.Placeholder"
                                  class="w-full rounded-(--lux-radius) border @(error is not null ? "border-(--lux-error)" : "border-(--lux-border)") bg-(--lux-bg) p-2.5 text-xs text-(--lux-text) disabled:opacity-50"
                                  value="@(form.GetValue(field.Key)?.ToString() ?? "")"
                                  data-slot="form-control"
                                  @oninput="@(e => form.SetValue(field.Key, e.Value?.ToString()))"
                                  @onblur="@(() => form.MarkTouched(field.Key))"></textarea>;

            case FormFieldKind.Password:
                var revealed = _revealedPasswords.Contains(field.Key);
                return @<div class="relative flex items-center">
                    <input id="@fieldId"
                           type="@(revealed ? "text" : "password")"
                           disabled="@disabled"
                           placeholder="@field.Placeholder"
                           value="@(form.GetValue(field.Key)?.ToString() ?? "")"
                           class="@inputClass pe-14"
                           data-slot="form-control"
                           @oninput="@(e => form.SetValue(field.Key, e.Value?.ToString()))"
                           @onblur="@(() => form.MarkTouched(field.Key))" />
                    <button type="button"
                            class="absolute end-1.5 inline-flex min-h-6 min-w-6 items-center justify-center rounded-(--lux-radius) px-2 py-0.5 text-[11px] font-medium text-(--lux-text-muted) hover:text-(--lux-text)"
                            aria-label="@(revealed ? "Hide password" : "Show password")"
                            data-slot="form-password-toggle"
                            @onclick="@(() => TogglePasswordReveal(field.Key))">
                        @(revealed ? "Hide" : "Show")
                    </button>
                </div>;

            case FormFieldKind.Number:
            case FormFieldKind.Slider:
                var numStr = form.GetValue(field.Key)?.ToString() ?? "";
                return @<input id="@fieldId"
                               type="@(field.Kind == FormFieldKind.Slider ? "range" : "number")"
                               min="@field.Min?.ToString(CultureInfo.InvariantCulture)"
                               max="@field.Max?.ToString(CultureInfo.InvariantCulture)"
                               step="@field.Step?.ToString(CultureInfo.InvariantCulture)"
                               disabled="@disabled"
                               placeholder="@field.Placeholder"
                               value="@numStr"
                               class="@inputClass"
                               data-slot="form-control"
                               @oninput="@(e => OnNumberInput(form, field.Key, e.Value?.ToString()))"
                               @onblur="@(() => form.MarkTouched(field.Key))" />;

            case FormFieldKind.Checkbox:
            case FormFieldKind.Switch:
                var isChecked = form.GetValue<bool>(field.Key);
                return @<label class="inline-flex cursor-pointer items-center gap-2 text-xs font-medium text-(--lux-text)">
                    <input id="@fieldId"
                           type="checkbox"
                           checked="@isChecked"
                           disabled="@disabled"
                           class="size-4 rounded border-(--lux-border) accent-(--lux-primary)"
                           data-slot="form-control"
                           @onchange="@(e => form.SetValue(field.Key, e.Value is bool b && b, markTouched: true))" />
                    <span>@field.Label</span>
                </label>;

            case FormFieldKind.Select:
            case FormFieldKind.AutoComplete:
                var options = form.GetFieldOptions(field);
                var currentVal = form.GetValue(field.Key)?.ToString() ?? "";
                return @<div class="flex items-center gap-1.5">
                    <select id="@fieldId"
                            disabled="@disabled"
                            value="@currentVal"
                            class="@inputClass"
                            data-slot="form-control"
                            @onchange="@(e => form.SetValue(field.Key, e.Value?.ToString(), markTouched: true))">
                        <option value="">@(field.Placeholder ?? "Select…")</option>
                        @foreach (var opt in options)
                        {
                            <option value="@opt.Value" disabled="@opt.Disabled" selected="@(opt.Value == currentVal)">@opt.Label</option>
                        }
                    </select>
                    @if (field.Clearable && !string.IsNullOrEmpty(currentVal))
                    {
                        <button type="button"
                                class="inline-flex size-8 shrink-0 items-center justify-center rounded-(--lux-radius) border border-(--lux-border) text-xs text-(--lux-text-muted) hover:text-(--lux-text)"
                                aria-label="Clear selection"
                                data-slot="form-control-clear"
                                @onclick="@(() => form.SetValue(field.Key, null, markTouched: true))">✕</button>
                    }
                </div>;

            case FormFieldKind.Radio:
                var radioOpts = form.GetFieldOptions(field);
                var radioVal = form.GetValue(field.Key)?.ToString() ?? "";
                return @<div class="flex flex-wrap gap-3" role="radiogroup" data-slot="form-control">
                    @foreach (var opt in radioOpts)
                    {
                        <label class="inline-flex cursor-pointer items-center gap-1.5 text-xs">
                            <input type="radio"
                                   name="@field.Key"
                                   value="@opt.Value"
                                   checked="@(opt.Value == radioVal)"
                                   disabled="@(disabled || opt.Disabled)"
                                   @onchange="@(() => form.SetValue(field.Key, opt.Value, markTouched: true))" />
                            <span>@opt.Label</span>
                        </label>
                    }
                </div>;

            default:
                var strVal = form.GetValue(field.Key)?.ToString() ?? "";
                return @<div class="flex items-center gap-1.5">
                    <input id="@fieldId"
                           type="@(field.Kind == FormFieldKind.Date ? "date" : field.Kind == FormFieldKind.Time ? "time" : "text")"
                           disabled="@disabled"
                           maxlength="@field.MaxLength"
                           placeholder="@field.Placeholder"
                           value="@strVal"
                           class="@inputClass"
                           data-slot="form-control"
                           @oninput="@(e => form.SetValue(field.Key, e.Value?.ToString()))"
                           @onblur="@(() => form.MarkTouched(field.Key))" />
                    @if (field.Clearable && !string.IsNullOrEmpty(strVal))
                    {
                        <button type="button"
                                class="inline-flex size-8 shrink-0 items-center justify-center rounded-(--lux-radius) border border-(--lux-border) text-xs text-(--lux-text-muted) hover:text-(--lux-text)"
                                aria-label="Clear"
                                data-slot="form-control-clear"
                                @onclick="@(() => form.SetValue(field.Key, "", markTouched: true))">✕</button>
                    }
                </div>;
        }
    }

    private RenderFragment RenderArrayField(FormController form, FormFieldSchema field, string spanStyle)
    {
        var items = form.GetArrayItems(field.Key);
        return @<div style="@spanStyle" class="flex flex-col gap-2.5 rounded-(--lux-radius-md) border border-(--lux-border) bg-(--lux-bg) p-3.5"
                     data-slot="form-array" data-form-field="@field.Key">
            <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-semibold text-(--lux-text-highlighted)">@(field.Label ?? field.Key)</span>
                <button type="button"
                        class="inline-flex h-7 items-center gap-1 rounded-(--lux-radius) border border-(--lux-border) bg-(--lux-bg-muted) px-2.5 text-xs font-medium text-(--lux-text-highlighted) hover:bg-(--lux-bg-elevated)"
                        data-slot="form-array-add"
                        @onclick="@(() => form.AddArrayItem(field))">
                    + @(field.AddItemLabel ?? "Add item")
                </button>
            </div>

            @if (items.Count == 0)
            {
                <p class="m-0 py-2 text-center text-xs text-(--lux-text-muted)" data-slot="form-array-empty">No items yet</p>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @for (var i = 0; i < items.Count; i++)
                    {
                        var idx = i;
                        var item = items[i];
                        <div class="flex items-center gap-2 rounded-(--lux-radius) border border-(--lux-border) p-2" data-slot="form-array-item">
                            <div class="grid flex-1 grid-cols-12 gap-2">
                                @if (field.Fields is not null)
                                {
                                    @foreach (var child in field.Fields)
                                    {
                                        item.TryGetValue(child.Key, out var cellVal);
                                        <div style="@($"grid-column: span {Math.Clamp(child.Span, 1, 12)} / span {Math.Clamp(child.Span, 1, 12)}")" class="flex flex-col gap-1">
                                            @if (!string.IsNullOrEmpty(child.Label))
                                            {
                                                <span class="text-[11px] font-medium text-(--lux-text-muted)">@child.Label</span>
                                            }
                                            <input type="text"
                                                   placeholder="@child.Placeholder"
                                                   value="@(cellVal?.ToString() ?? "")"
                                                   class="h-8 w-full rounded-(--lux-radius) border border-(--lux-border) bg-(--lux-bg) px-2.5 text-xs"
                                                   data-slot="form-array-input"
                                                   data-child="@child.Key"
                                                   @oninput="@(e => form.SetArrayItemValue(field.Key, idx, child.Key, e.Value?.ToString()))" />
                                        </div>
                                    }
                                }
                            </div>
                            <button type="button"
                                    class="inline-flex size-7 shrink-0 items-center justify-center rounded-(--lux-radius) text-xs text-(--lux-error-text) hover:bg-(--lux-error)/10"
                                    aria-label="Remove item"
                                    data-slot="form-array-remove"
                                    @onclick="@(() => form.RemoveArrayItem(field.Key, idx))">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            }
        </div>;
    }

    private void TogglePasswordReveal(string key)
    {
        if (!_revealedPasswords.Remove(key)) _revealedPasswords.Add(key);
    }

    private static void OnNumberInput(FormController form, string key, string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            form.SetValue(key, null);
        }
        else if (double.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var d))
        {
            form.SetValue(key, d);
        }
    }

    private async Task OnFormSubmitAsync()
    {
        if (EffectiveController is null) return;
        var ok = await EffectiveController.SubmitAsync();
        if (ok && OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(EffectiveController.BuildOutput());
        }
    }

    private async Task OnCancelAsync()
    {
        if (EffectiveController is null) return;
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync(EffectiveController.BuildOutput());
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnFormChanged;
        }
    }
}
