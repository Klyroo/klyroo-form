<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Form</RootNamespace>
    <PackageId>Klyroo.Form.DataAnnotations</PackageId>
    <PackageTags>klyroo;forms;dataannotations;validation;model-binding;blazor</PackageTags>
    <Description>Klyroo Form DataAnnotations: builds a Klyroo.Form form from a C# model and its System.ComponentModel.DataAnnotations attributes, and validates IValidatableObject and custom validation attributes at submit.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Directory.Build.props packs the README of the repository root as the package readme: this package has its own. -->
    <None Remove="$(MSBuildProjectDirectory)\..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Klyroo.Form.Core\Klyroo.Form.Core.csproj" />
  </ItemGroup>
</Project>
